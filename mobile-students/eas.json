{
  "cli": {
    "version": ">= 18.7.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development"
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://k74uz0viqb.execute-api.ap-northeast-1.amazonaws.com/api/mobile"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://k74uz0viqb.execute-api.ap-northeast-1.amazonaws.com/api/mobile"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
